# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== MongoDB =====
MONGO_URI=mongodb://127.0.0.1:27017/marqet

# ===== JWT (RS256 key pair, base64-encoded PEM) =====
# Generate once:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -i private.pem | tr -d '\n'   -> JWT_PRIVATE_KEY_BASE64
#   base64 -i public.pem  | tr -d '\n'   -> JWT_PUBLIC_KEY_BASE64
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_EXPIRES_IN=1d

# ===== Upstash Redis (TCP endpoint, NOT the REST API endpoint) =====
UPSTASH_REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379

# ===== Storage provider: r2 | s3 =====
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_DOMAIN=https://pub-xxxxxxxx.r2.dev
# Used only when STORAGE_PROVIDER=s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional custom endpoint (MinIO/LocalStack). Leave empty for real AWS.
S3_ENDPOINT=

# ===== Tripo AI =====
TRIPO_API_KEY=tsk_your-tripo-api-key
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_POLL_INTERVAL_MS=5000
TRIPO_POLL_TIMEOUT_MS=900000

# ===== NAFDAC lookup provider: mock | registry =====
# mock = deterministic fake records (offline demos)
# registry = live scrape of the official Greenbook (greenbook.nafdac.gov.ng)
NAFDAC_PROVIDER=mock
# Required only when NAFDAC_PROVIDER=registry
NAFDAC_REGISTRY_BASE_URL=https://greenbook.nafdac.gov.ng
NAFDAC_REGISTRY_API_KEY=

# ===== Email notifications =====
# Transport: smtp (nodemailer — Mailtrap/Resend/Postmark/SES relay) or plunk (useplunk.com REST)
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=Marqet <no-reply@marqet.shop>
# SMTP relay (Mailtrap sandbox example)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Plunk transport alternative
# EMAIL_PROVIDER=plunk
# EMAIL_PROVIDER_API_KEY=

# ===== Optional bootstrap admin seed =====
# ADMIN_SEED_EMAIL=no-reply@marqet-api.com
# ADMIN_SEED_PASSWORD=
